
"""
SENTINEL-X
Security Monitoring and Threat Detection System

Version: 1.0.0
Purpose: Analyse Linux SSH authentication logs.
"""

import re
import argparse
import json
from collections import defaultdict
from pathlib import Path


class SentinelX:

    def __init__(self, threshold=5):
        if threshold < 1:
            raise ValueError("Threshold must be at least 1.")

        self.threshold = threshold
        self.failed_attempts = defaultdict(list)
        self.successful_logins = defaultdict(list)
        self.alerts = []
        self.analysed_lines = 0

        self.failed_pattern = re.compile(
            r"Failed password for "
            r"(?:invalid user )?(?P<user>\S+) "
            r"from (?P<ip>\S+) port"
        )

        self.success_pattern = re.compile(
            r"Accepted (?:password|publickey) for "
            r"(?P<user>\S+) from (?P<ip>\S+) port"
        )

    def analyse_line(self, line, line_number):

        self.analysed_lines += 1

        failed = self.failed_pattern.search(line)

        if failed:
            ip = failed.group("ip")
            user = failed.group("user")

            self.failed_attempts[ip].append({
                "user": user,
                "line": line_number
            })

            return

        successful = self.success_pattern.search(line)

        if successful:
            ip = successful.group("ip")
            user = successful.group("user")

            self.successful_logins[ip].append({
                "user": user,
                "line": line_number
            })

    def detect_threats(self):

        self.alerts = []

        for ip, attempts in self.failed_attempts.items():

            count = len(attempts)

            if count >= self.threshold:

                self.alerts.append({
                    "alert": "POSSIBLE BRUTE FORCE ATTACK",
                    "severity": "HIGH",
                    "source_ip": ip,
                    "failed_attempts": count,
                    "technique": "T1110",
                    "framework": "MITRE ATT&CK"
                })

                threshold_line = attempts[
                    self.threshold - 1
                ]["line"]

                for login in self.successful_logins.get(ip, []):

                    if login["line"] > threshold_line:

                        self.alerts.append({
                            "alert": "SUCCESSFUL LOGIN AFTER REPEATED FAILURES",
                            "severity": "CRITICAL",
                            "source_ip": ip,
                            "username": login["user"],
                            "technique": "T1110",
                            "framework": "MITRE ATT&CK"
                        })

                        break

        return self.alerts

    def generate_report(self):

        return {
            "project": "SENTINEL-X",
            "version": "1.0.0",
            "analysed_lines": self.analysed_lines,
            "unique_source_ips": len(
                self.failed_attempts
            ),
            "total_failed_attempts": sum(
                len(attempts)
                for attempts in self.failed_attempts.values()
            ),
            "total_alerts": len(self.alerts),
            "alerts": self.alerts
        }


def main():

    parser = argparse.ArgumentParser(
        description="SENTINEL-X Authentication Log Analyzer"
    )

    parser.add_argument(
        "logfile",
        help="Path to the authentication log file"
    )

    parser.add_argument(
        "--threshold",
        type=int,
        default=5,
        help="Failed login threshold (default: 5)"
    )

    parser.add_argument(
        "--output",
        default="",
        help="Optional JSON report output path"
    )

    args = parser.parse_args()

    try:
        sentinel = SentinelX(args.threshold)

        with open(
            args.logfile,
            "r",
            encoding="utf-8",
            errors="replace"
        ) as log_file:

            for line_number, line in enumerate(
                log_file, start=1
            ):
                sentinel.analyse_line(line, line_number)

        sentinel.detect_threats()
        report = sentinel.generate_report()

        print("\n====================================")
        print("       SENTINEL-X SECURITY ENGINE")
        print("====================================")

        print("Lines analysed:", report["analysed_lines"])
        print("Failed attempts:", report["total_failed_attempts"])
        print("Alerts generated:", report["total_alerts"])

        print("\n--- SECURITY ALERTS ---")

        if report["alerts"]:
            for alert in report["alerts"]:
                print(json.dumps(alert, indent=4))
        else:
            print("No suspicious activity detected.")

        if args.output:
            Path(args.output).write_text(
                json.dumps(report, indent=4),
                encoding="utf-8"
            )
            print("\nReport saved to:", args.output)

    except FileNotFoundError:
        print("ERROR: Log file not found.")

    except ValueError as error:
        print("ERROR:", error)


if __name__ == "__main__":
    main()
